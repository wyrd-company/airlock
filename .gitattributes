# Normalize line endings in the repository; check out native on each platform.
* text=auto

# Files that must keep LF regardless of platform.
*.sh text eol=lf
*.fish text eol=lf
taskfile.yml text eol=lf

# Lockfiles are authored by tooling, not by hand.
Cargo.lock linguist-generated=true

# Binary assets.
*.png binary
*.jpg binary
*.gif binary
*.woff2 binary

# Recorded responses, written by crates/wasm/examples/record_audit.rs.
crates/wasm/tests/fixtures/*.json linguist-generated=true

# The action's bundle and module, built by scripts/build-action.sh and
# checked against the source in CI.
dist/** linguist-generated=true
dist/*.wasm binary
action/pnpm-lock.yaml linguist-generated=true
.intentional/release-model.json text eol=lf
