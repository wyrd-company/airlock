# Normalize line endings in the repository; check out native on each platform.
* text=auto

# Files that must keep LF regardless of platform.
*.sh text eol=lf
*.fish text eol=lf
taskfile.yml text eol=lf

# Lockfiles are authored by tooling, not by hand.
Cargo.lock linguist-generated=true

# Binary assets.
*.png binary
*.jpg binary
*.gif binary
*.woff2 binary
